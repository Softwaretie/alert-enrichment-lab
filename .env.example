# --- Secrets ---
# Recommended: don't fill these in here. Run `python scripts/setup_secrets.py`
# instead, which stores them in your OS credential store (Windows Credential
# Manager / macOS Keychain / Linux Secret Service) -- encrypted at rest and
# tied to your login, rather than sitting here as plaintext. config.py checks
# the credential store first and only falls back to these .env values if a
# secret hasn't been migrated yet, so filling them in here still works.

# Anthropic (Claude) API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# VirusTotal API key — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB API key — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Gmail label to poll for phishing reports forwarded to the security mailbox
GMAIL_QUERY=label:phishing-reports is:unread

# Path to the OAuth client secret downloaded from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json

# Where the OAuth token cache is stored after first login
GMAIL_TOKEN_PATH=token.json

# Claude model to use for alert analysis
CLAUDE_MODEL=claude-sonnet-5-5

# Time of day scripts/scheduler.py runs the overnight batch (24h, local time)
BATCH_SCHEDULE_HOUR=2
BATCH_SCHEDULE_MINUTE=0

# Days a deleted finding stays recoverable on the dashboard's Deleted page
# before it's permanently purged (DB row + its logs/*.json file)
DELETED_RETENTION_DAYS=7

# Slack notifications (only needed if you pass --slack to main.py).
# Bot token from https://api.slack.com/apps -> your app -> OAuth & Permissions
# (needs the chat:write scope) -- also a secret; prefer setup_secrets.py.
# Channel ID (not a secret): right-click the channel in Slack -> View channel
# details -> copy the ID at the bottom (starts with C).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Yahoo Mail (optional) ---
# Yahoo has no OAuth Mail API for third-party apps (confirmed: their public
# API catalog only lists Fantasy Sports and Sign In With Yahoo), so this uses
# IMAP with an app-specific password instead. Enable 2-step verification on
# the Yahoo account, then generate one under Account Security > Generate app
# password. Yahoo is processed automatically once email/app password are
# both set; --no-yahoo disables it, --yahoo forces it on (and errors if they
# aren't set). The app password is a secret; prefer setup_secrets.py.
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=

# Yahoo has no Gmail-style label search -- point this at a folder you file
# forwarded phishing reports into, or leave as INBOX
YAHOO_FOLDER=INBOX

# Standard IMAP SEARCH criteria
YAHOO_SEARCH_CRITERIA=UNSEEN

# --- URL sandboxing (optional) ---
# Sandboxes up to 2 URLs per email in an isolated browser via urlscan.io,
# reporting what a link actually does rather than just its reputation
# history. Free API key: https://urlscan.io/user/signup. A secret; prefer
# setup_secrets.py. Leave blank to skip -- VirusTotal/AbuseIPDB alone still run.
URLSCAN_API_KEY=

# --- Attachment analysis (optional, on by default) ---
# Attachments are downloaded into memory, hashed (the SHA-256 is looked up in
# VirusTotal -- a lookup only, nothing is uploaded) and inspected for macros,
# scripts, executables, disguised file types, hidden links and similar red flags.
# Files are never saved to disk, opened by another program, or executed.
# Set to 0 to turn it off; main.py --no-attachments skips it for a single run.
ATTACHMENT_ANALYSIS=1

# Largest single attachment to download and analyse, in MB (bigger files are
# listed in the report but skipped)
ATTACHMENT_MAX_MB=25

# --- Dashboard (optional) ---
# Flask debug mode shows an interactive debugger on errors. Leave it off unless
# you are changing the code yourself.
DASHBOARD_DEBUG=0
